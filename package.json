{
  "name": "borno-higher-study",
  "version": "1.0.0",
  "private": true,
  "description": "Borno Higher Study - Your Future. Your University. Your World.",
  "scripts": {
    "dev": "npm run dev:all",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "dev:all": "node scripts/dev.js",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build": "npm run build:client && npm run build:server",
    "db:push": "npm --prefix server run prisma:generate && npm --prefix server run prisma:push",
    "db:seed": "npm --prefix server run prisma:seed",
    "test:auth": "npx tsx scripts/verifyAuthSystem.ts",
    "test:coverage": "npx tsx scripts/verifyInstitutionCoverage.ts",
    "test:english-tests": "npx tsx scripts/verifyEnglishTestModule.ts",
    "test:moi": "npx tsx scripts/verifyMoiSystem.ts",
    "test:seo": "npx tsx scripts/seoAudit.ts"
  },
  "keywords": [
    "study-abroad",
    "higher-education",
    "university-discovery",
    "scholarships",
    "ielts",
    "borno"
  ],
  "author": "Borno Higher Study Team",
  "license": "MIT"
}
