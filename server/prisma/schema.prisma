// Borno Higher Study - SQLite Prisma Schema
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          String    @default("STUDENT") // SUPER_ADMIN, ADMIN, MODERATOR, CONTRIBUTOR, STUDENT, VISITOR
  avatarUrl     String?
  targetCountry String?
  targetDegree  String?
  targetSubject String?
  budget               Float?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  savedUniversities SavedUniversity[]
  savedScholarships SavedScholarship[]
  applicationPlans  ApplicationPlan[]
  agentConversations AgentConversation[]
  auditLogs         AuditLog[]

  // Contributor, Community, Profile & Document Relations
  studentProfile       StudentProfile?
  contributorApp       ContributorApplication?
  posts                Post[]
  moderationReviews    ModerationReview[]
  workspaceMembers     WorkspaceMember[]
  financialSubmissions FinancialDocumentSubmission[]
  notifications        Notification[]
  informationReports   InformationReport[]
  deadlineBookmarks    UserDeadlineBookmark[]
  testCorrections      TestAcceptanceCorrection[]
  testPreferences      StudentTestPreference[]
  moiCorrections       MoiCorrectionReport[]
  visaCorrections      VisaCorrectionReport[]
  eligibilityAssessments EligibilityAssessment[]
  articleBookmarks     ArticleBookmark[]
  editorialReviews     EditorialReview[]
  contentCorrectionReports ContentCorrectionReport[]
  cvDrafts             CVBuilderDraft[]

  // Country Work Guide & Policy Relations
  policyRevisions       PolicyRevision[]
  policyCorrectionReports PolicyCorrectionReport[]
  dataImportJobs        DataImportJob[]
  policyVerifications   PolicyVerification[]
  savedRequirementReports SavedRequirementsReport[]
}

model Country {
  id                 String   @id @default(uuid())
  name               String   @unique
  slug               String   @unique
  code               String   @unique // e.g. FI, DE, US, NL
  flagEmoji          String
  continent          String   @default("Europe")
  region             String   @default("Northern Europe")
  currencyCode       String
  currencySymbol     String
  exchangeRateToBdt  Float    // e.g. 1 EUR = ~128 BDT
  overview           String
  capitalCity        String
  majorCities        String   @default("[]") // JSON-serialized array of major student cities
  languages          String   @default("[]") // JSON-serialized array of languages
  avgLivingCostMonthly Float  // in local currency
  avgTuitionMin      Float
  avgTuitionMax      Float
  postStudyWorkVisa  String
  visaGuideUrl       String
  officialPortalUrl  String
  isFeatured         Boolean  @default(false)
  lastVerifiedAt     DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cities             City[]
  universities       University[]
  scholarships       Scholarship[]
  visaStatistics     VisaStatistics[]
  visaPolicies       VisaPolicy[]
  visaCentres        VisaApplicationCentre[]
  applicantRules     ApplicantJurisdictionRule[]
  socialAccounts     OfficialSocialAccount[]
  socialUpdates      SocialUpdate[]

  // Country Work Guide Relations
  countryLanguages      CountryLanguage[]
  minimumWagePolicies   MinimumWagePolicy[]
  wageJurisdictions     WageJurisdiction[]
  studentWorkPolicies   StudentWorkPolicy[]
  postStudyWorkRoutes   PostStudyWorkRoute[]
  careerSectors         CareerSector[]
  careerRoadmaps        CareerRoadmap[]
  officialSources       CountryOfficialSource[]
  policyVerifications   PolicyVerification[]
  policyRevisions       PolicyRevision[]
  policyCorrectionReports PolicyCorrectionReport[]
}

model City {
  id                 String   @id @default(uuid())
  name               String
  countryId          String
  country            Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  isCapital          Boolean  @default(false)
  costOfLivingIndex  Float?
  monthlyLivingCost  Float?   // in local currency

  universities       University[]
  campuses           Campus[]

  @@unique([name, countryId])
}

model University {
  id                 String             @id @default(uuid())
  name               String
  slug               String             @unique
  logoUrl            String?
  coverImageUrl      String?
  countryId          String
  country            Country            @relation(fields: [countryId], references: [id])
  cityId             String?
  city               City?              @relation(fields: [cityId], references: [id])
  cityName           String?            // Denormalized for convenience
  address            String?
  websiteUrl         String
  admissionsUrl      String
  type               String             @default("PUBLIC") // PUBLIC, PRIVATE, SEMI_GOVERNMENT, OTHER
  institutionType    String             @default("UNIVERSITY") // UNIVERSITY, COLLEGE, BUSINESS_SCHOOL, INSTITUTE_OF_TECHNOLOGY, COMMUNITY_COLLEGE, UNIVERSITY_COLLEGE, PATHWAY_PROVIDER, LANGUAGE_SCHOOL, VOCATIONAL_TECHNICAL, RESEARCH_INSTITUTE
  accreditationStatus String            @default("RECOGNIZED") // RECOGNIZED, STATE_ACCREDITED, MINISTRY_APPROVED, CANDIDATE
  accreditationBody  String?            // e.g. QQI, SKVC, ZEvA, AACSB, EQUIS
  levelsOffered      String             @default("BACHELOR,MASTER,PHD") // Comma-delimited
  qualificationsOffered String          @default("BACHELOR,MASTER,PHD") // Comma-delimited: BACHELOR, MASTER, PHD, FOUNDATION, PATHWAY, DIPLOMA, CERTIFICATE, VOCATIONAL
  verificationStatus String             @default("VERIFIED") // VERIFIED, PENDING_REVIEW, NEEDS_UPDATE, CONFLICT_DETECTED
  lastVerifiedAt     DateTime           @default(now())
  qsRanking          Int?
  timesRanking       Int?
  acceptanceRate     Float?
  internationalOfficeEmail String?
  internationalOfficePhone String?
  sourceUrl          String
  whedId             String?
  sourceRegistry     String?            // e.g. IPEDS, HESA, DAAD_HRK, OKM_FINLAND, TEQSA, RUCT, WHED
  normalizedDomain   String?            // Normalized domain for duplicate detection
  provenance         String?            // Provenance description / registry license details
  candidateId        String?            // Link to origin candidate record if imported via queue
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  campuses           Campus[]
  faculties          Faculty[]
  programs           Program[]
  tuitionFees        TuitionFee[]
  scholarships       Scholarship[]
  englishReqs        EnglishRequirement[]
  admissionCycles    AdmissionCycle[]
  savedByUsers       SavedUniversity[]
  officialSources    OfficialSource[]
  verificationHistory VerificationHistory[]
  deadlines          ApplicationDeadline[]
  testPolicies       UniversityTestPolicy[]
  moiPolicies        MoiPolicy[]
  moiSources         MoiPolicySource[]
  moiExemptions      EnglishLanguageExemption[]
  academicRequirements AcademicRequirement[]
}

model Campus {
  id           String     @id @default(uuid())
  name         String
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  cityId       String?
  city         City?      @relation(fields: [cityId], references: [id])
  address      String?
  isMainCampus Boolean    @default(false)
}

model Faculty {
  id           String     @id @default(uuid())
  name         String
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  programs     Program[]
}

model Subject {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  category    String    // e.g. "Computing and Technology", "Engineering", "Business"
  description String?

  programs    Program[]
}

model Program {
  id                 String             @id @default(uuid())
  name               String
  slug               String
  universityId       String
  university         University         @relation(fields: [universityId], references: [id], onDelete: Cascade)
  facultyId          String?
  faculty            Faculty?           @relation(fields: [facultyId], references: [id])
  subjectId          String?
  subject            Subject?           @relation(fields: [subjectId], references: [id])
  subjectName        String?            // Denormalized
  subjectCategory    String?            // Denormalized
  degreeLevel        String             // BACHELOR, MASTER, PHD, DIPLOMA
  qualificationType  String             @default("BACHELOR") // BACHELOR, MASTER, PHD, FOUNDATION, PATHWAY, DIPLOMA, POSTGRAD_DIPLOMA, CERTIFICATE, VOCATIONAL, ENGLISH_PREP
  studentCategory    String             @default("INTERNATIONAL") // INTERNATIONAL, EU_EEA, ALL
  durationMonths     Int                // e.g. 24 for 2-year Master's
  creditsEcts        Int?               // e.g. 120 ECTS
  languageOfInstruction String          @default("English")
  annualTuitionLocal Float
  totalTuitionLocal  Float?
  currencyCode       String
  applicationFeeLocal Float             @default(0)
  programUrl         String
  curriculumUrl      String?
  prerequisites      String?
  intakeSeason       String?
  verificationStatus String             @default("VERIFIED")
  lastVerifiedAt     DateTime           @default(now())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  requirements       ProgramRequirement?
  englishReq         EnglishRequirement?
  tuitionFees        TuitionFee[]
  scholarships       Scholarship[]
  admissionCycles    AdmissionCycle[]
  deadlines          ApplicationDeadline[]
  testPolicies       UniversityTestPolicy[]
  moiPolicies        MoiPolicy[]
  academicRequirements AcademicRequirement[]
  eligibilityAssessments EligibilityAssessment[]
}

model ProgramRequirement {
  id                     String   @id @default(uuid())
  programId              String   @unique
  program                Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  minGpaScale4           Float?
  minGpaScale5           Float?
  greRequired            Boolean  @default(false)
  minGreTotal            Int?
  gmatRequired           Boolean  @default(false)
  minGmatScore           Int?
  workExperienceMonths   Int      @default(0)
  requiredDocuments      String   @default("[]") // JSON string of required documents
  portfolioRequired      Boolean  @default(false)
  interviewRequired      Boolean  @default(false)
  updatedAt              DateTime @updatedAt
}

model EnglishRequirement {
  id                     String      @id @default(uuid())
  universityId           String?
  university             University? @relation(fields: [universityId], references: [id], onDelete: Cascade)
  programId              String?     @unique
  program                Program?    @relation(fields: [programId], references: [id], onDelete: Cascade)
  ieltsOverall           Float
  ieltsReading           Float?
  ieltsListening         Float?
  ieltsSpeaking          Float?
  ieltsWriting           Float?
  toeflIbtOverall        Int?
  toeflReading           Int?
  toeflListening         Int?
  toeflSpeaking          Int?
  toeflWriting           Int?
  pteOverall             Int?
  pteReading             Int?
  pteListening           Int?
  pteSpeaking            Int?
  pteWriting             Int?
  duolingoScore          Int?
  moeAccepted            Boolean     @default(false) // Medium of instruction exemption accepted?
  moeDetails             String?
  testValidityYears      Int         @default(2)
  notes                  String?
  sourceUrl              String
  lastVerifiedAt         DateTime    @default(now())
}

model TuitionFee {
  id                 String      @id @default(uuid())
  universityId       String?
  university         University? @relation(fields: [universityId], references: [id], onDelete: Cascade)
  programId          String?
  program            Program?    @relation(fields: [programId], references: [id], onDelete: Cascade)
  academicYear       String      // e.g. "2025/2026"
  annualTuitionLocal Float
  currencyCode       String
  isEuOnlyRate       Boolean     @default(false)
  internationalRate  Float
  paymentInstallments Int        @default(2)
  lastVerifiedAt     DateTime    @default(now())
}

model Scholarship {
  id                     String          @id @default(uuid())
  name                   String
  provider               String
  type                   String          @default("GOVERNMENT") // GOVERNMENT, UNIVERSITY_MERIT, NEED_BASED, etc.
  countryId              String?
  country                Country?        @relation(fields: [countryId], references: [id])
  universityId           String?
  university             University?     @relation(fields: [universityId], references: [id])
  programId              String?
  program                Program?        @relation(fields: [programId], references: [id])
  degreeLevels           String          @default("MASTER,PHD") // Comma-delimited
  coveragePercent        Float           @default(100) // 100 for full tuition
  stipendMonthlyLocal    Float           @default(0)
  travelAllowanceLocal   Float           @default(0)
  currencyCode           String
  isFullyFunded          Boolean         @default(false)
  openToBangladesh       Boolean         @default(true)
  eligibleNationalities  String          @default("[]") // JSON string of nationalities
  academicRequirements  String
  languageRequirements  String?
  deadlineDate           DateTime?
  deadlineText           String?
  officialApplicationUrl String
  sourceUrl              String
  verificationStatus     String          @default("VERIFIED")
  lastVerifiedAt         DateTime        @default(now())
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  eligibilityRules       ScholarshipEligibility[]
  savedByUsers           SavedScholarship[]
  deadlines              ApplicationDeadline[]
}

model ScholarshipEligibility {
  id            String      @id @default(uuid())
  scholarshipId String
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  criterionKey  String      // e.g. "min_gpa", "citizenship", "age_limit"
  criterionValue String
  isMandatory   Boolean     @default(true)
}

model AdmissionCycle {
  id           String      @id @default(uuid())
  universityId String?
  university   University? @relation(fields: [universityId], references: [id], onDelete: Cascade)
  programId    String?
  program      Program?    @relation(fields: [programId], references: [id], onDelete: Cascade)
  cycleName    String      // e.g. "Autumn 2025 Intake", "Spring 2026 Intake"
  opensAt      DateTime
  deadlineAt   DateTime
  decisionAt   DateTime?
  semesterStart DateTime?
  isActive     Boolean     @default(true)
  notes        String?
}

model OfficialSource {
  id           String     @id @default(uuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  title        String
  url          String
  domain       String
  sourceType   String     @default("OFFICIAL_WEBSITE") // OFFICIAL_WEBSITE, MOE_PORTAL, WHED_IAU, ACCREDITATION_BODY
  lastCheckedAt DateTime  @default(now())
  httpStatus   Int?       @default(200)
}

model VerificationHistory {
  id           String             @id @default(uuid())
  universityId String
  university   University         @relation(fields: [universityId], references: [id], onDelete: Cascade)
  verifiedBy   String             // User ID or "SYSTEM_IMPORT"
  status       String             @default("VERIFIED")
  notes        String?
  verifiedAt   DateTime           @default(now())
}

model SavedUniversity {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, universityId])
}

model SavedScholarship {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scholarshipId String
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([userId, scholarshipId])
}

model ApplicationPlan {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetCountry   String
  targetDegree    String
  intake          String            // e.g. "Autumn 2025"
  estimatedBudget Float?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tasks           ApplicationTask[]
}

model ApplicationTask {
  id          String          @id @default(uuid())
  planId      String
  plan        ApplicationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String          // "Documents", "Testing", "Application", "Visa", "Finance"
  dueDate     DateTime?
  status      String          @default("NOT_STARTED")
  order       Int             @default(0)
}

model AgentConversation {
  id        String         @id @default(uuid())
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  title     String         @default("Study Abroad Consultation")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  messages  AgentMessage[]
}

model AgentMessage {
  id             String            @id @default(uuid())
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String            // "user" or "agent"
  content        String
  citations      String?           // JSON string of { title, url, verifiedDate, entityType }
  structuredData String?           // JSON string of universities/courses extracted
  createdAt      DateTime          @default(now())
}

model ImportJob {
  id             String             @id @default(uuid())
  sourceName     String
  sourceType     String             // "CSV", "API", "JSON_SYNC"
  totalRecords   Int                @default(0)
  validRecords   Int                @default(0)
  invalidRecords Int                @default(0)
  status         String             // "COMPLETED", "FAILED", "IN_PROGRESS"
  errorLog       String?
  createdAt      DateTime           @default(now())
  completedAt    DateTime?
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // e.g. "UPDATE_INSTITUTION", "VERIFY_COURSE", "APPROVE_CONTRIBUTOR", "APPROVE_FINANCIAL_DOC"
  entityType String   // "Institution", "Program", "Post", "FinancialDoc", "Contributor"
  entityId   String
  details    String?  // JSON string
  timestamp  DateTime @default(now())
}

// ==========================================
// 4. STUDENT CONTRIBUTOR & COMMUNITY MODELS
// ==========================================

model ContributorApplication {
  id                    String    @id @default(uuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyDestination      String    // e.g. "Germany", "Finland", "Ireland", "Lithuania"
  currentInstitution    String    // e.g. "Trinity College Dublin"
  qualificationEnrolled String    // e.g. "MSc Data Science"
  statementOfIntent     String
  writingSampleUrl      String?
  status                String    @default("PENDING") // PENDING, APPROVED, REJECTED, SUSPENDED
  adminFeedback         String?
  appliedAt             DateTime  @default(now())
  reviewedAt            DateTime?
  reviewedBy            String?
}

model Post {
  id                 String    @id @default(uuid())
  title              String
  slug               String    @unique
  category           String    // STUDY_ABROAD_EXPERIENCE, APPLICATION_GUIDE, SCHOLARSHIP_EXPERIENCE, COURSE_REVIEW, CITY_ACCOMMODATION, TEST_PREPARATION, STUDENT_LIFE
  destinationCountry String?
  institutionName    String?
  content            String    // Markdown body
  excerpt            String
  authorId           String
  author             User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  status             String    @default("PENDING_REVIEW") // DRAFT, PENDING_REVIEW, APPROVED, REJECTED, ARCHIVED
  moderatorNotes     String?
  views              Int       @default(0)
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  moderationReviews  ModerationReview[]
}

model ModerationReview {
  id          String   @id @default(uuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  reviewerId  String
  reviewer    User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  status      String   // APPROVED, REJECTED, CHANGES_REQUESTED
  reviewNotes String?
  reviewedAt  DateTime @default(now())
}

model Workspace {
  id          String            @id @default(uuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  members     WorkspaceMember[]
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("EDITOR") // OWNER, EDITOR, VIEWER
  joinedAt    DateTime  @default(now())

  @@unique([workspaceId, userId])
}

// ==========================================
// 6. BANK STATEMENT & FINANCIAL VERIFICATION
// ==========================================

model FinancialDocumentSubmission {
  id                      String    @id @default(uuid())
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentCategory        String    // BANK_STATEMENT, SOLVENCY_CERTIFICATE, SCHOLARSHIP_AWARD_LETTER, SPONSORSHIP_LETTER, TUITION_RECEIPT, OTHER_FINANCIAL_EVIDENCE
  title                   String
  originalFilename        String
  storagePath             String    // Secure private relative path on disk (never public)
  fileSizeBytes           Int
  mimeType                String
  status                  String    @default("SUBMITTED") // DRAFT, SUBMITTED, UNDER_REVIEW, CORRECTIONS_REQUESTED, APPROVED_INTERNAL, REJECTED, WITHDRAWN
  currency                String    @default("BDT")
  balanceAmount           Float?
  bankName                String?   // e.g. "Eastern Bank PLC", "City Bank", "Islami Bank"
  accountHolderType       String    @default("STUDENT") // STUDENT, PARENT_SPONSOR, INSTITUTION
  verificationDisclaimer  String    @default("Internal document review completed. This does not constitute legal banking verification or guarantee visa issuance.")
  reviewedBy              String?   // Admin User ID
  reviewerNotes           String?
  submittedAt             DateTime  @default(now())
  reviewedAt              DateTime?
  updatedAt               DateTime  @updatedAt

  history                 DocumentReviewHistory[]
}

model DocumentReviewHistory {
  id             String                      @id @default(uuid())
  submissionId   String
  submission     FinancialDocumentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  changedBy      String                      // Admin ID or Student
  previousStatus String
  newStatus      String
  notes          String?
  timestamp      DateTime                    @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ACTION_REQUIRED
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ==========================================
// 7. APPLICATION DEADLINES & INTAKES SYSTEM
// ==========================================

model ApplicationDeadline {
  id                 String             @id @default(uuid())
  universityId       String?
  university         University?        @relation(fields: [universityId], references: [id], onDelete: Cascade)
  programId          String?
  program            Program?           @relation(fields: [programId], references: [id], onDelete: Cascade)
  scholarshipId      String?
  scholarship        Scholarship?       @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  
  intakeSemester     String             // e.g. "Autumn 2026", "Spring 2027", "Winter 2026"
  academicYear       String             // e.g. "2026-2027"
  applicationType    String             @default("POSTGRADUATE") // UNDERGRADUATE, POSTGRADUATE, PHD, FOUNDATION, PATHWAY, SCHOLARSHIP
  targetAudience     String             @default("INTERNATIONAL") // INTERNATIONAL, DOMESTIC, ALL
  roundName          String?            // e.g. "Round 1 (Priority)", "Final Round"
  
  openDate           DateTime?
  closeDate          DateTime?
  openTime           String?            // e.g. "09:00"
  closeTime          String?            // e.g. "23:59"
  timeZone           String             @default("UTC") // e.g. "Europe/Dublin", "Europe/Berlin", "UTC"
  isRolling          Boolean            @default(false)
  status             String             @default("OPEN") // NOT_ANNOUNCED, UPCOMING, OPEN, CLOSING_SOON, CLOSED, SUSPENDED, EXTENDED, ROLLING, UNCONFIRMED
  isDisputed         Boolean            @default(false)
  disputeNote        String?
  
  applicationFee     Float?
  currencyCode       String?            @default("EUR")
  officialAppUrl     String?
  officialSourceUrl  String
  lastVerifiedAt     DateTime           @default(now())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  revisions          DeadlineRevision[]
  bookmarks          UserDeadlineBookmark[]
}

model DeadlineRevision {
  id                 String              @id @default(uuid())
  deadlineId         String
  deadline           ApplicationDeadline @relation(fields: [deadlineId], references: [id], onDelete: Cascade)
  changedBy          String              // Admin User ID
  previousOpenDate   DateTime?
  newOpenDate        DateTime?
  previousCloseDate  DateTime?
  newCloseDate       DateTime?
  previousStatus     String?
  newStatus          String
  reason             String
  sourceEvidenceUrl  String
  timestamp          DateTime            @default(now())
}

// ==========================================
// 8. STUDENT INFORMATION REPORTS & CORRECTIONS
// ==========================================

model InformationReport {
  id                     String                @id @default(uuid())
  reportNumber           String                @unique // e.g. "RPT-2026-101"
  reporterId             String?
  reporter               User?                 @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  reporterEmail          String?
  
  entityType             String                // UNIVERSITY, PROGRAM, SCHOLARSHIP, DEADLINE, OTHER
  entityId               String                // ID of affected entity
  entitySlug             String?
  entityName             String                // Name of university, program, or scholarship
  
  fieldBelievedIncorrect String                // OPEN_DATE, CLOSE_DATE, TUITION_FEE, ADMISSION_REQS, ENGLISH_REQS, BROKEN_LINK, MISLEADING_INFO, DUPLICATE_RECORD, OTHER
  reasonCategory         String                // INCORRECT_DATE, OUTDATED_INFO, WRONG_TUITION, BROKEN_LINK, MISLEADING_INFO, OTHER
  description            String
  currentValue           String?
  proposedCorrection     String?
  officialEvidenceUrl    String
  supportingDocPath      String?
  
  status                 String                @default("PENDING_REVIEW") // SUBMITTED, PENDING_REVIEW, UNDER_INVESTIGATION, MORE_INFO_REQUESTED, RESUBMITTED, APPROVED, REJECTED, DUPLICATE, RESOLVED, CLOSED
  adminFeedback          String?
  reviewedBy             String?               // Admin User ID
  reviewedAt             DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  comments               ReportComment[]
  revisions              DataRevisionHistory[]
  proposals              CorrectionProposal[]
}

model ReportComment {
  id          String            @id @default(uuid())
  reportId    String
  report      InformationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  authorId    String?
  authorName  String
  authorRole  String            // ADMIN, STUDENT
  message     String
  evidenceUrl String?
  createdAt   DateTime          @default(now())
}

model DataRevisionHistory {
  id            String             @id @default(uuid())
  reportId      String?
  report        InformationReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  entityType    String
  entityId      String
  fieldName     String
  previousValue String
  newValue      String
  sourceUrl     String
  reviewerId    String
  reviewerName  String
  reason        String
  appliedAt     DateTime           @default(now())
}

model CorrectionProposal {
  id                String             @id @default(uuid())
  reportId          String?
  report            InformationReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  entityType        String             // UNIVERSITY, PROGRAM, SCHOLARSHIP, DEADLINE
  entityId          String
  fieldName         String
  currentValue      String?
  proposedValue     String
  sourceEvidenceUrl String
  status            String             @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedBy        String?
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model StudentProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  educationLevel     String?  // HSC, BACHELOR, MASTER, OTHER
  currentInstitution String?
  gpa                Float?
  preferredCountries String   @default("[]") // JSON string of country slugs
  preferredSubjects  String   @default("[]") // JSON string of subject names
  englishTestTaken   String?  // IELTS, TOEFL, PTE, NONE
  englishScore       Float?
  targetIntakeSeason String?  // Autumn 2026, Spring 2027
  budgetAnnualUsd    Float?
